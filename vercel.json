{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "staging": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/postula/jobs-refresh",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/postula/billing/trials",
      "schedule": "15 12 * * *"
    }
  ]
}
